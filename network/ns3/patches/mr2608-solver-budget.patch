+// Attribute contract only: no Python interpreter, scene loading or GPU is needed.
+class SionnaSolverBudgetTest : public TestCase
+{
+  public:
+    SionnaSolverBudgetTest()
+        : TestCase("Sionna solver budgets retain defaults and expose checked values")
+    {
+    }
+
+  private:
+    void DoRun() override
+    {
+        auto model = CreateObject<SionnaRtChannelModel>();
+        UintegerValue samples;
+        UintegerValue paths;
+        model->GetAttribute("SamplesPerSource", samples);
+        model->GetAttribute("MaxNumPathsPerSource", paths);
+        NS_TEST_ASSERT_MSG_EQ(samples.Get(), 1000000, "Sionna sampling default changed");
+        NS_TEST_ASSERT_MSG_EQ(paths.Get(), 1000000, "Sionna path allocation default changed");
+        model->SetAttribute("SamplesPerSource", UintegerValue(20000));
+        model->SetAttribute("MaxNumPathsPerSource", UintegerValue(10000));
+        model->GetAttribute("SamplesPerSource", samples);
+        model->GetAttribute("MaxNumPathsPerSource", paths);
+        NS_TEST_ASSERT_MSG_EQ(samples.Get(), 20000, "Configured ray budget is not observable");
+        NS_TEST_ASSERT_MSG_EQ(paths.Get(), 10000, "Configured path budget is not observable");
+        NS_TEST_ASSERT_MSG_EQ(model->SetAttributeFailSafe("SamplesPerSource", UintegerValue(0)),
+                              false, "Zero ray budget must be rejected");
+        NS_TEST_ASSERT_MSG_EQ(model->SetAttributeFailSafe("MaxNumPathsPerSource", UintegerValue(0)),
+                              false, "Zero path budget must be rejected");
+    }
+};
+
+class SionnaSolverBudgetTestSuite : public TestSuite
+{
+  public:
+    SionnaSolverBudgetTestSuite()
+        : TestSuite("sionna-solver-budget", TestSuite::Type::UNIT)
+    {
+        AddTestCase(new SionnaSolverBudgetTest(), TestCase::Duration::QUICK);
+    }
+};
+
+static SionnaSolverBudgetTestSuite g_sionnaSolverBudgetTestSuite;
