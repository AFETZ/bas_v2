+void
+SionnaRtChannelModel::ValidateFullMeshCandidates(uint32_t count, uint32_t capacity,
+    const std::vector<uint32_t>& perTx, const std::vector<uint32_t>& selfPerTx)
+{
+    const auto n = m_receiverBatchMobility.size();
+    const auto perTxCap = GetReceiverBatchAllocation(n - 1);
+    const uint64_t totalCap = uint64_t(perTxCap) * n;
+    if (totalCap > std::numeric_limits<uint32_t>::max() || capacity != totalCap ||
+        perTx.size() != n || selfPerTx.size() != n)
+        throw std::invalid_argument("Full mesh candidate shape/allocation mismatch");
+    uint64_t sum = 0;
+    bool saturated = count >= capacity;
+    for (size_t i = 0; i < n; ++i)
+    {
+        sum += perTx[i];
+        if (selfPerTx[i] > perTx[i])
+            throw std::invalid_argument("Full mesh self candidates exceed source candidates");
+        saturated |= perTx[i] >= perTxCap;
+    }
+    if (sum != count)
+        throw std::invalid_argument("Full mesh source candidate counts disagree with total");
+    auto& stats = m_fullMeshStats;
+    stats.lastCandidateCount = count;
+    stats.lastCandidateBufferSize = capacity;
+    stats.lastPerTxCandidateCap = perTxCap;
+    stats.lastCandidateCountsPerTx = perTx;
+    stats.lastSelfCandidateCountsPerTx = selfPerTx;
+    if (saturated)
+    {
+        ++stats.candidateCapacityReachedCalls;
+        throw std::runtime_error("Full mesh per-source candidate capacity reached; no clipped result admitted");
+    }
+}
