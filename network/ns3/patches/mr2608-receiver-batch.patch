+MatrixBasedChannelModel::DoubleVector
+SionnaRtChannelModel::ConvertScalarPathArray(const py::object values, size_t receiverIndex) const
+{
+    const auto info = py::buffer(values).request();
+    const auto dimensions = m_RtPathSolverConfig.syntheticArray ? 3 : 5;
+    if (info.ndim != dimensions || receiverIndex >= static_cast<size_t>(info.shape[0]))
+        throw std::out_of_range("Scalar path extraction requires a valid receiver and path tensor");
+    const auto paths = info.shape[dimensions - 1];
+    if (paths == 0) return DoubleVector{};
+    const auto* data = static_cast<const double*>(info.ptr) + receiverIndex * (info.size / info.shape[0]);
+    return DoubleVector(data, data + paths);
 }
 
