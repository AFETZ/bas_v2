+        NS_TEST_ASSERT_MSG_EQ(rejected, true, "Unregistered batching must fail before Python/GPU");
+        std::vector<Ptr<const MobilityModel>> mobility;
+        std::vector<Ptr<const PhasedArrayModel>> antennas;
+        for (uint32_t i = 0; i < 6; ++i)
+        {
+            auto node = CreateObject<Node>();
+            auto position = CreateObject<ConstantPositionMobilityModel>();
+            position->SetPosition(Vector(i * 10, 0, 3));
+            node->AggregateObject(position);
+            mobility.push_back(position);
+            auto antenna = CreateObject<UniformPlanarArray>();
+            antenna->SetAttribute("NumRows", UintegerValue(1));
+            antenna->SetAttribute("NumColumns", UintegerValue(1));
+            antennas.push_back(antenna);
+        }
+        model->SetAttribute("MaxNumPathsPerSource", UintegerValue(1000));
+        model->SetReceiverBatchEndpoints(mobility, antennas);
+        NS_TEST_ASSERT_MSG_EQ(model->GetReceiverBatchAllocation(5), 5000, "Allocation must preserve per-RX budget");
+        model->SetAttribute("ReceiverBatchEnabled", BooleanValue(true));
+        auto stats = model->GetReceiverBatchStats();
+        NS_TEST_ASSERT_MSG_EQ(stats.enabled, true, "Mode readback lost explicit selection");
+        NS_TEST_ASSERT_MSG_EQ(stats.registeredEndpoints, 6, "Roster was truncated");
+        NS_TEST_ASSERT_MSG_EQ(stats.configuredMaxPathsPerSource, 1000, "Base budget was silently changed");
+        rejected = false;
+        try { (void)model->GetChannel(mobility[2], mobility[5], antennas[5], antennas[2]); }
+        catch (const std::invalid_argument&) { rejected = true; }
+        NS_TEST_ASSERT_MSG_EQ(rejected, true, "Mismatched endpoint/antenna provenance was accepted");
+        NS_TEST_ASSERT_MSG_EQ(model->GetReceiverBatchStats().attemptedCalls, 0, "Rejected pair invoked Python");
+        model->Dispose();
+        NS_TEST_ASSERT_MSG_EQ(model->GetReceiverBatchStats().registeredEndpoints, 0, "Dispose retained endpoint resources");
+
+        auto invalid = CreateObject<SionnaRtChannelModel>();
+        auto duplicates = mobility;
+        duplicates[1] = duplicates[0];
+        rejected = false;
+        try { invalid->SetReceiverBatchEndpoints(duplicates, antennas); }
+        catch (const std::invalid_argument&) { rejected = true; }
+        NS_TEST_ASSERT_MSG_EQ(rejected, true, "Duplicate node identity accepted");
+        NS_TEST_ASSERT_MSG_EQ(invalid->GetReceiverBatchStats().registeredEndpoints, 0, "Failed registration leaked partial roster");
+        auto wide = CreateObject<UniformPlanarArray>();
