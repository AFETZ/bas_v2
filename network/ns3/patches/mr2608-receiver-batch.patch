+
+void
+SionnaRtChannelModel::SetReceiverBatchEndpoints(
+    const std::vector<Ptr<const MobilityModel>>& mobility,
+    const std::vector<Ptr<const PhasedArrayModel>>& antennas)
+{
+    if (m_receiverBatchEnabled || !m_channelMatrixMap.empty())
+        throw std::runtime_error("Receiver batch endpoints must be configured before enabling/solving");
+    auto previousMobility = m_receiverBatchMobility;
+    auto previousAntennas = m_receiverBatchAntennas;
+    m_receiverBatchMobility = mobility;
+    m_receiverBatchAntennas = antennas;
+    try { ValidateReceiverBatchEndpoints(); }
+    catch (...)
+    {
+        m_receiverBatchMobility = std::move(previousMobility);
+        m_receiverBatchAntennas = std::move(previousAntennas);
+        throw;
+    }
+}
+
+void
+SionnaRtChannelModel::SetReceiverBatchEnabled(bool enabled)
+{
+    if (enabled != m_receiverBatchEnabled && !m_channelMatrixMap.empty())
+        throw std::runtime_error("Receiver batch mode cannot change after channel generation");
+    if (enabled) ValidateReceiverBatchEndpoints();
+    m_receiverBatchEnabled = enabled;
+}
+
+bool
+SionnaRtChannelModel::GetReceiverBatchEnabled() const
+{
+    return m_receiverBatchEnabled;
+}
+
+uint32_t
+SionnaRtChannelModel::GetReceiverBatchAllocation(uint32_t receivers) const
+{
+    if (receivers == 0 || receivers > 5 ||
+        m_maxNumPathsPerSource > std::numeric_limits<uint32_t>::max() / receivers)
+        throw std::overflow_error("Receiver batch allocation requires 1..5 RX and a positive uint32 budget product");
+    return m_maxNumPathsPerSource * receivers;
+}
+
+SionnaRtChannelModel::ReceiverBatchStats
+SionnaRtChannelModel::GetReceiverBatchStats() const
+{
+    auto stats = m_receiverBatchStats;
+    stats.enabled = m_receiverBatchEnabled;
+    stats.registeredEndpoints = m_receiverBatchMobility.size();
+    stats.configuredMaxPathsPerSource = m_maxNumPathsPerSource;
+    return stats;
+}
+
+void
+SionnaRtChannelModel::ValidateReceiverBatchEndpoints() const
+{
+    const auto count = m_receiverBatchMobility.size();
+    if (count < 2 || count > 6 || count != m_receiverBatchAntennas.size())
+        throw std::invalid_argument("Receiver batch requires exactly 2..6 registered radio endpoints");
+    if (!m_RtPathSolverConfig.syntheticArray)
+        throw std::invalid_argument("Receiver batch requires the explicit synthetic iso 1x1 reference");
+    for (size_t i = 0; i < count; ++i)
+    {
+        auto mobility = m_receiverBatchMobility[i];
+        auto antenna = DynamicCast<const UniformPlanarArray>(m_receiverBatchAntennas[i]);
+        if (!mobility || !mobility->GetObject<Node>() || !antenna ||
+            antenna->GetNumRows() != 1 || antenna->GetNumColumns() != 1 ||
+            antenna->GetNumElems() != 1 || antenna->GetNumPorts() != 1 ||
+            antenna->GetNumPols() != 1 || antenna->GetPolSlant() != 0.0 ||
+            !DynamicCast<const IsotropicAntennaModel>(antenna->GetAntennaElement()))
+            throw std::invalid_argument("Receiver batch supports attached nodes with iso 1x1 V 0dBi arrays only");
+        DoubleValue elementGain;
+        antenna->GetAntennaElement()->GetAttribute("Gain", elementGain);
+        if (elementGain.Get() != 0.0)
+            throw std::invalid_argument("Receiver batch requires the 0dBi isotropic reference element");
+        if (AntennaSceneFingerprint(antenna) != AntennaSceneFingerprint(m_receiverBatchAntennas[0]))
+            throw std::invalid_argument("Receiver batch arrays must have the same reference configuration");
+        for (const Vector& value : {mobility->GetPosition(), mobility->GetVelocity(), BodyOrientation(mobility)})
+            if (!std::isfinite(value.x) || !std::isfinite(value.y) || !std::isfinite(value.z))
+                throw std::invalid_argument("Receiver batch endpoint has nonfinite pose, velocity or orientation");
+        for (size_t j = 0; j < i; ++j)
+            if (mobility->GetObject<Node>()->GetId() == m_receiverBatchMobility[j]->GetObject<Node>()->GetId() ||
+                antenna->GetId() == m_receiverBatchAntennas[j]->GetId())
+                throw std::invalid_argument("Receiver batch node and antenna identifiers must be unique");
+    }
+    (void)GetReceiverBatchAllocation(count - 1);
+}
+
+void
+SionnaRtChannelModel::ValidateReceiverBatchPair(Ptr<const MobilityModel> aMob,
+                                               Ptr<const MobilityModel> bMob,
+                                               Ptr<const PhasedArrayModel> aAntenna,
+                                               Ptr<const PhasedArrayModel> bAntenna) const
+{
+    ValidateReceiverBatchEndpoints();
+    bool aFound = false, bFound = false;
+    for (size_t i = 0; i < m_receiverBatchMobility.size(); ++i)
+    {
+        aFound |= aMob == m_receiverBatchMobility[i] && aAntenna == m_receiverBatchAntennas[i];
+        bFound |= bMob == m_receiverBatchMobility[i] && bAntenna == m_receiverBatchAntennas[i];
+    }
+    if (!aFound || !bFound || aMob == bMob)
+        throw std::invalid_argument("Pair is outside the registered receiver batch; use an explicit separate pairwise model for sources");
+}
+
+py::object
+SionnaRtChannelModel::CalculateReceiverBatchPaths(const py::module_ rt, const py::object scene,
+                                                  uint32_t receiverCount)
+{
+    if (py::str(rt.attr("__version__")).cast<std::string>() != "1.2.0")
+        throw std::runtime_error("Receiver batching is verified only for the pinned Sionna RT 1.2.0 API");
+    auto& stats = m_receiverBatchStats;
+    ++stats.attemptedCalls;
+    stats.lastReceiverCount = receiverCount;
+    stats.lastAllocatedMaxPathsPerSource = GetReceiverBatchAllocation(receiverCount);
+    stats.lastCandidateCount = stats.lastCandidateBufferSize = 0;
+    auto solver = rt.attr("PathSolver")();
+    // Pinned API instrumentation only: observe the standard pre-shrink buffer,
+    // without changing any rays, candidates or coefficients.
+    py::object candidateGenerator = solver.attr("_candidate_generator");
+    solver.attr("_candidate_generator") = py::cpp_function(
+        [this, candidateGenerator](py::args args, py::kwargs kwargs) {
+            auto buffer = candidateGenerator(*args, **kwargs);
+            auto np = py::module_::import("numpy");
+            auto count = np.attr("asarray")(buffer.attr("paths_counter"));
+            m_receiverBatchStats.lastCandidateCount =
+                count.attr("reshape")(-1).attr("__getitem__")(0).cast<uint32_t>();
+            m_receiverBatchStats.lastCandidateBufferSize = buffer.attr("buffer_size").cast<uint32_t>();
+            if (m_receiverBatchStats.lastCandidateCount >= m_receiverBatchStats.lastCandidateBufferSize)
+            {
+                ++m_receiverBatchStats.candidateCapacityReachedCalls;
+                throw std::runtime_error("Receiver batch candidate capacity reached; refusing potentially clipped RT paths");
+            }
+            return buffer;
+        });
+    auto paths = solver(py::arg("scene") = scene,
+        py::arg("samples_per_src") = m_samplesPerSource,
+        py::arg("max_num_paths_per_src") = stats.lastAllocatedMaxPathsPerSource,
+        py::arg("max_depth") = m_RtPathSolverConfig.maxDepth,
+        py::arg("los") = m_RtPathSolverConfig.los,
+        py::arg("specular_reflection") = m_RtPathSolverConfig.specularReflection,
+        py::arg("diffuse_reflection") = m_RtPathSolverConfig.diffuseReflection,
+        py::arg("refraction") = m_RtPathSolverConfig.refraction,
+        py::arg("diffraction") = m_RtPathSolverConfig.diffraction,
+        py::arg("edge_diffraction") = m_RtPathSolverConfig.edgeDiffraction,
+        py::arg("synthetic_array") = m_RtPathSolverConfig.syntheticArray,
+        py::arg("seed") = m_RtPathSolverConfig.seed);
+    if (DoesNumberOfPathsExceedMaximum(GetNumberOfPathsFromCir(paths)))
+        throw std::runtime_error("Sionna batch retained-path limit exceeded; no automatic reduction");
+    if (m_isImageRendered) SceneRenderImageToFile(rt, paths, scene);
+    NS_LOG_INFO("Receiver batch paths computed: nrx=" << receiverCount
+        << " samples_per_src=" << m_samplesPerSource
+        << " allocated_max_num_paths_per_src=" << stats.lastAllocatedMaxPathsPerSource
+        << " candidate_count=" << stats.lastCandidateCount);
+    return paths;
+}
