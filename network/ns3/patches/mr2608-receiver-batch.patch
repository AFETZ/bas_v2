+class ReceiverBatchSliceTest : public TestCase
+{
+  public:
+    ReceiverBatchSliceTest() : TestCase("Batched CIR delays Doppler and angles select the requested receiver") {}
+  private:
+    void DoRun() override
+    {
+        py::scoped_interpreter python;
+        auto np = py::module_::import("numpy");
+        py::dict variables;
+        py::exec(R"(
+import numpy as np
+from types import SimpleNamespace
+a = np.arange(6, dtype=np.complex128).reshape(3,1,1,1,2,1)
+tau = np.arange(6, dtype=np.float64).reshape(3,1,2) * 1e-6
+paths = SimpleNamespace(cir=lambda **kw: (a, tau), doppler=np.arange(6).reshape(3,1,2),
+    phi_r=np.arange(6).reshape(3,1,2)+10, theta_r=np.arange(6).reshape(3,1,2)+20,
+    phi_t=np.arange(6).reshape(3,1,2)+30, theta_t=np.arange(6).reshape(3,1,2)+40)
+)", variables);
+        auto model = CreateObject<ReceiverBatchContractProbe>();
+        py::object paths = variables["paths"];
+        auto selected = model->CalculateCirFromPaths(paths, 2);
+        NS_TEST_ASSERT_MSG_EQ(std::real(selected(0, 0, 0)), 4.0, "CIR returned RX0 instead of RX2");
+        NS_TEST_ASSERT_MSG_EQ(std::real(selected(0, 0, 1)), 5.0, "CIR path stride is wrong");
+        auto a = CreateObject<Node>(), b = CreateObject<Node>();
+        auto am = CreateObject<ConstantPositionMobilityModel>(), bm = CreateObject<ConstantPositionMobilityModel>();
+        a->AggregateObject(am); b->AggregateObject(bm);
+        auto parameters = model->CalculateChannelParamsFromPaths(paths, am, bm, 2);
+        NS_TEST_ASSERT_MSG_EQ_TOL(parameters->m_delay[0], 4e-6, 1e-15, "Delays returned RX0 or wrong units");
+        NS_TEST_ASSERT_MSG_EQ(parameters->m_doppler[1], 5.0, "Doppler returned RX0");
+        NS_TEST_ASSERT_MSG_EQ(parameters->m_angle[0][0], 14.0, "Arrival azimuth returned RX0");
+        NS_TEST_ASSERT_MSG_EQ(parameters->m_angle[1][0], 24.0, "Arrival zenith returned RX0");
+        NS_TEST_ASSERT_MSG_EQ(parameters->m_angle[2][0], 34.0, "Departure azimuth returned RX0");
+        NS_TEST_ASSERT_MSG_EQ(parameters->m_angle[3][0], 44.0, "Departure zenith returned RX0");
+        bool rejected = false;
+        try { (void)model->CalculateCirFromPaths(paths, 3); }
+        catch (const std::out_of_range&) { rejected = true; }
+        NS_TEST_ASSERT_MSG_EQ(rejected, true, "Out-of-range receiver index was accepted");
+        model->Dispose();
+        Simulator::Destroy();
+    }
+};
