+void
+SionnaRtChannelModel::GenerateReceiverBatch(Ptr<const MobilityModel> txMob,
+                                           Ptr<const PhasedArrayModel> txAntenna)
+{
+    using Clock = std::chrono::steady_clock;
+    const auto batchStarted = Clock::now();
+    std::vector<size_t> receivers;
+    for (size_t i = 0; i < m_receiverBatchMobility.size(); ++i)
+        if (m_receiverBatchMobility[i] != txMob) receivers.push_back(i);
+    auto rt = py::module_::import("sionna.rt");
+    auto scene = CreateScene(rt, txMob, m_receiverBatchMobility[receivers[0]],
+                              txAntenna, m_receiverBatchAntennas[receivers[0]]);
+    for (size_t index = 1; index < receivers.size(); ++index)
+    {
+        const auto name = "batch_rx_" + std::to_string(index);
+        auto rx = scene.attr("get")(name);
+        if (rx.is_none())
+        {
+            rx = rt.attr("Receiver")(py::arg("name") = name,
+                                      py::arg("position") = py::make_tuple(0.0, 0.0, 0.0));
+            scene.attr("add")(rx);
+        }
+        auto mobility = m_receiverBatchMobility[receivers[index]];
+        auto antenna = DynamicCast<const UniformPlanarArray>(m_receiverBatchAntennas[receivers[index]]);
+        const auto position = mobility->GetPosition(), velocity = mobility->GetVelocity();
+        VectorValue orientation;
+        const auto angles = mobility->GetAttributeFailSafe("Orientation", orientation)
+            ? orientation.Get() : Vector(antenna->GetAlpha(), antenna->GetBeta(), 0.0);
+        rx.attr("position") = py::make_tuple(position.x, position.y, position.z);
+        rx.attr("velocity") = py::make_tuple(velocity.x, velocity.y, velocity.z);
+        rx.attr("orientation") = py::make_tuple(angles.x, angles.y, angles.z);
+    }
+    if (py::len(scene.attr("receivers")) != receivers.size() || py::len(scene.attr("transmitters")) != 1)
+        throw std::runtime_error("Receiver batch scene contains unexpected endpoints");
+    const auto scenePrepared = Clock::now();
+    auto paths = CalculateReceiverBatchPaths(rt, scene, receivers.size());
+    const auto solverReturned = Clock::now();
+    auto np = py::module_::import("numpy");
+    py::tuple cir = paths.attr("cir")(py::arg("normalize_delays") = m_normalizeDelays,
+                                      py::arg("out_type") = "numpy");
+    py::object coefficients = np.attr("ascontiguousarray")(cir[0], py::arg("dtype") = np.attr("complex128"));
+    py::object delays = np.attr("ascontiguousarray")(cir[1], py::arg("dtype") = np.attr("float64"));
+    py::object doppler = np.attr("ascontiguousarray")(paths.attr("doppler"), py::arg("dtype") = np.attr("float64"));
+    std::vector<py::object> angles;
+    for (const auto* name : {"phi_r", "theta_r", "phi_t", "theta_t"})
+        angles.push_back(np.attr("ascontiguousarray")(paths.attr(name), py::arg("dtype") = np.attr("float64")));
+    const auto coefficientShape = py::buffer(coefficients).request();
+    if (coefficientShape.ndim != 6 || static_cast<size_t>(coefficientShape.shape[0]) != receivers.size())
+        throw std::runtime_error("Receiver batch CIR shape does not match the registered receivers");
+    if (DoesNumberOfPathsExceedMaximum(coefficientShape.shape[4]))
+        throw std::runtime_error("Sionna batch retained-path limit exceeded; no automatic reduction");
+    if (m_isImageRendered) SceneRenderImageToFile(rt, paths, scene);
+    // Extract/validate all receiver tensors before publishing fresh matrices.
+    // Any exception propagates to the existing fail-closed simulator boundary.
+    std::vector<Ptr<ChannelMatrix>> matrices;
+    std::vector<Ptr<SionnaRtChannelParams>> parameters;
+    for (size_t index = 0; index < receivers.size(); ++index)
+    {
+        auto rxMob = m_receiverBatchMobility[receivers[index]];
+        auto rxAntenna = m_receiverBatchAntennas[receivers[index]];
+        auto matrix = CreateNewMatrixChannel(ConvertCirArray(coefficients, index), txMob,
+                                               rxMob, txAntenna, rxAntenna);
+        matrix->m_antennaPair = {txAntenna->GetId(), rxAntenna->GetId()};
+        matrices.push_back(matrix);
+        Double2DVector receiverAngles;
+        for (const auto& direction : angles)
+            receiverAngles.push_back(ConvertScalarPathArray(direction, index));
+        parameters.push_back(CreateChannelParams(txMob, rxMob,
+            ConvertScalarPathArray(delays, index), ConvertScalarPathArray(doppler, index),
+            std::move(receiverAngles)));
+    }
+    const auto extractionFinished = Clock::now();
+    for (size_t index = 0; index < receivers.size(); ++index)
+    {
+        auto rxMob = m_receiverBatchMobility[receivers[index]];
+        auto rxAntenna = m_receiverBatchAntennas[receivers[index]];
+        const auto txId = txMob->GetObject<Node>()->GetId(), rxId = rxMob->GetObject<Node>()->GetId();
+        m_channelMatrixMap[GetKey(txAntenna->GetId(), rxAntenna->GetId())] = matrices[index];
+        m_channelParamsMap[GetKey(txId, rxId)] = parameters[index];
+        m_pairPositionSnapshots[GetKey(txId, rxId)] = {txId, txMob->GetPosition(), rxId,
+            rxMob->GetPosition(), txMob->GetVelocity(), rxMob->GetVelocity(),
+            BodyOrientation(txMob), BodyOrientation(rxMob)};
+        (void)txAntenna->IsChannelOutOfDate(rxAntenna); // This pair was just regenerated.
+    }
+    ++m_receiverBatchStats.completedCalls;
+    m_receiverBatchStats.generatedLinks += receivers.size();
+    const auto published = Clock::now();
+    const auto elapsedNs = [](Clock::time_point start, Clock::time_point end) -> uint64_t {
+        return std::chrono::duration_cast<std::chrono::nanoseconds>(end - start).count();
+    };
+    auto& stats = m_receiverBatchStats;
+    stats.lastScenePrepareWallNs = elapsedNs(batchStarted, scenePrepared);
+    stats.lastSolverWallNs = elapsedNs(scenePrepared, solverReturned);
+    stats.lastExtractionWallNs = elapsedNs(solverReturned, extractionFinished);
+    stats.lastCachePublishWallNs = elapsedNs(extractionFinished, published);
+    stats.lastBatchWallNs = elapsedNs(batchStarted, published);
+    stats.scenePrepareWallNs += stats.lastScenePrepareWallNs;
+    stats.solverWallNs += stats.lastSolverWallNs;
+    stats.extractionWallNs += stats.lastExtractionWallNs;
+    stats.cachePublishWallNs += stats.lastCachePublishWallNs;
+    stats.batchWallNs += stats.lastBatchWallNs;
+    if (stats.lastBatchWallNs > stats.maxBatchWallNs)
+        stats.maxBatchWallNs = stats.lastBatchWallNs;
 }
 
