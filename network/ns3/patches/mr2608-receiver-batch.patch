+class ReceiverBatchApiTest : public TestCase
+{
+  public:
+    ReceiverBatchApiTest() : TestCase("Receiver batching is explicit, bounded, registered and fail closed") {}
+  private:
+    void DoRun() override
+    {
+        auto model = CreateObject<SionnaRtChannelModel>();
+        NS_TEST_ASSERT_MSG_EQ(model->GetReceiverBatchEnabled(), false, "Legacy mode must remain pairwise");
+        bool rejected = false;
