+class ReceiverBatchContractProbe : public SionnaRtChannelModel
+{
+  public:
+    using SionnaRtChannelModel::CalculateCirFromPaths;
+    using SionnaRtChannelModel::CalculateChannelParamsFromPaths;
+    using SionnaRtChannelModel::ValidateReceiverBatchPair;
+    Ptr<ChannelMatrix> Seed(Ptr<const MobilityModel> a, Ptr<const MobilityModel> b,
+                            Ptr<const PhasedArrayModel> aa, Ptr<const PhasedArrayModel> ba)
+    {
+        auto matrix = Create<ChannelMatrix>();
+        matrix->m_channel = Complex3DVector(1, 1, 1);
+        matrix->m_channel(0, 0, 0) = {1.0, 0.0};
+        matrix->m_generatedTime = Simulator::Now();
+        matrix->m_nodeIds = {a->GetObject<Node>()->GetId(), b->GetObject<Node>()->GetId()};
+        matrix->m_antennaPair = {aa->GetId(), ba->GetId()};
+        m_channelMatrixMap[GetKey(aa->GetId(), ba->GetId())] = matrix;
+        m_pairPositionSnapshots[GetKey(matrix->m_nodeIds.first, matrix->m_nodeIds.second)] =
+            {matrix->m_nodeIds.first, a->GetPosition(), matrix->m_nodeIds.second, b->GetPosition(),
+             a->GetVelocity(), b->GetVelocity(), Vector(), Vector()};
+        (void)aa->IsChannelOutOfDate(ba);
+        return matrix;
+    }
+};
+
+class ReceiverBatchApiTest : public TestCase
+{
+  public:
+    ReceiverBatchApiTest() : TestCase("Receiver batching is explicit, bounded, registered and fail closed") {}
+  private:
+    void DoRun() override
+    {
+        auto model = CreateObject<ReceiverBatchContractProbe>();
+        NS_TEST_ASSERT_MSG_EQ(model->GetReceiverBatchEnabled(), false, "Legacy mode must remain pairwise");
+        bool rejected = false;
+        try { model->SetReceiverBatchEnabled(true); } catch (const std::invalid_argument&) { rejected = true; }
+        NS_TEST_ASSERT_MSG_EQ(rejected, true, "Unregistered batching must fail before Python/GPU");
+        std::vector<Ptr<const MobilityModel>> mobility;
+        std::vector<Ptr<const PhasedArrayModel>> antennas;
+        for (uint32_t i = 0; i < 6; ++i)
+        {
+            auto node = CreateObject<Node>();
+            auto position = CreateObject<ConstantPositionMobilityModel>();
+            position->SetPosition(Vector(i * 10, 0, 3));
+            node->AggregateObject(position);
+            mobility.push_back(position);
+            auto antenna = CreateObject<UniformPlanarArray>();
+            antenna->SetAttribute("NumRows", UintegerValue(1));
+            antenna->SetAttribute("NumColumns", UintegerValue(1));
+            antennas.push_back(antenna);
+        }
+        model->SetAttribute("MaxNumPathsPerSource", UintegerValue(1000));
+        model->SetReceiverBatchEndpoints(mobility, antennas);
+        NS_TEST_ASSERT_MSG_EQ(model->GetReceiverBatchAllocation(5), 5000, "Allocation must preserve per-RX budget");
+        model->SetAttribute("ReceiverBatchEnabled", BooleanValue(true));
+        auto stats = model->GetReceiverBatchStats();
+        NS_TEST_ASSERT_MSG_EQ(stats.enabled, true, "Mode readback lost explicit selection");
+        NS_TEST_ASSERT_MSG_EQ(stats.registeredEndpoints, 6, "Roster was truncated");
+        NS_TEST_ASSERT_MSG_EQ(stats.configuredMaxPathsPerSource, 1000, "Base budget was silently changed");
+        model->ValidateReceiverBatchPair(mobility[2], mobility[5], antennas[2], antennas[5]);
+        rejected = false;
+        try { model->ValidateReceiverBatchPair(mobility[2], mobility[5], antennas[5], antennas[2]); }
+        catch (const std::invalid_argument&) { rejected = true; }
+        NS_TEST_ASSERT_MSG_EQ(rejected, true, "Mismatched endpoint/antenna provenance was accepted");
+        auto matrix = model->Seed(mobility[2], mobility[5], antennas[2], antennas[5]);
+        NS_TEST_ASSERT_MSG_EQ(model->GetChannel(mobility[2], mobility[5], antennas[2], antennas[5]), matrix,
+                              "Valid existing cache must be used without a solver call");
+        NS_TEST_ASSERT_MSG_EQ(model->GetChannel(mobility[5], mobility[2], antennas[5], antennas[2]), matrix,
+                              "Reciprocal cache key changed in batch mode");
+        NS_TEST_ASSERT_MSG_EQ(model->GetReceiverBatchStats().attemptedCalls, 0, "Cache hit invoked Python");
+        auto displaced = DynamicCast<const ConstantPositionMobilityModel>(mobility[2]);
+        model->SetUpdateDistanceThreshold(0.5);
+        auto mutablePosition = ConstCast<ConstantPositionMobilityModel>(displaced);
+        mutablePosition->SetPosition(Vector(21, 0, 3));
+        NS_TEST_ASSERT_MSG_EQ(model->ChannelMatrixNeedsUpdate(matrix, mobility[2], mobility[5]), true,
+                              "Batch mode relaxed the original displacement invalidator");
+        rejected = false;
+        try { model->SetReceiverBatchEnabled(false); } catch (const std::runtime_error&) { rejected = true; }
+        NS_TEST_ASSERT_MSG_EQ(rejected, true, "Hot mode change with existing matrices must fail");
+        model->Dispose();
+        NS_TEST_ASSERT_MSG_EQ(model->GetReceiverBatchStats().registeredEndpoints, 0, "Dispose retained endpoint resources");
+
+        auto invalid = CreateObject<ReceiverBatchContractProbe>();
+        auto duplicates = mobility;
+        duplicates[1] = duplicates[0];
+        rejected = false;
+        try { invalid->SetReceiverBatchEndpoints(duplicates, antennas); }
+        catch (const std::invalid_argument&) { rejected = true; }
+        NS_TEST_ASSERT_MSG_EQ(rejected, true, "Duplicate node identity accepted");
+        NS_TEST_ASSERT_MSG_EQ(invalid->GetReceiverBatchStats().registeredEndpoints, 0, "Failed registration leaked partial roster");
+        auto wide = CreateObject<UniformPlanarArray>();
+        wide->SetAttribute("NumRows", UintegerValue(2));
+        auto wrongArrays = antennas;
+        wrongArrays[1] = wide;
+        rejected = false;
+        try { invalid->SetReceiverBatchEndpoints(mobility, wrongArrays); }
+        catch (const std::invalid_argument&) { rejected = true; }
+        NS_TEST_ASSERT_MSG_EQ(rejected, true, "Unsupported multi-element array accepted");
+        invalid->SetAttribute("MaxNumPathsPerSource", UintegerValue(0xffffffffU));
+        rejected = false;
+        try { (void)invalid->GetReceiverBatchAllocation(5); }
+        catch (const std::overflow_error&) { rejected = true; }
+        NS_TEST_ASSERT_MSG_EQ(rejected, true, "uint32 allocation overflow accepted");
+        invalid->Dispose();
+        Simulator::Destroy();
+    }
+};
