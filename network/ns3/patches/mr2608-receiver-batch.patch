+class ReceiverBatchSameTimeMatrixTest : public TestCase
+{
+  public:
+    ReceiverBatchSameTimeMatrixTest() : TestCase("New matrices in the same simulation event invalidate long-term coefficients") {}
+  private:
+    void DoRun() override
+    {
+        auto loss = CreateObject<ReceiverBatchLongTermProbe>();
+        auto a = CreateObject<UniformPlanarArray>(), b = CreateObject<UniformPlanarArray>();
+        for (auto antenna : {a, b})
+        {
+            antenna->SetAttribute("NumRows", UintegerValue(1));
+            antenna->SetAttribute("NumColumns", UintegerValue(1));
+            PhasedArrayModel::ComplexVector weights(1);
+            weights[0] = {1.0, 0.0};
+            antenna->SetBeamformingVector(weights);
+        }
+        auto first = Create<MatrixBasedChannelModel::ChannelMatrix>();
+        first->m_generatedTime = Simulator::Now();
+        first->m_antennaPair = {a->GetId(), b->GetId()};
+        first->m_channel = MatrixBasedChannelModel::Complex3DVector(1, 1, 1);
+        first->m_channel(0, 0, 0) = {1.0, 0.0};
+        NS_TEST_ASSERT_MSG_EQ(std::real((*loss->GetLongTerm(first, a, b))(0, 0, 0)),
+                              1.0, "Initial long-term coefficient is incorrect");
+        auto second = Create<MatrixBasedChannelModel::ChannelMatrix>();
+        second->m_generatedTime = first->m_generatedTime; // Same ns-3 event/time.
+        second->m_antennaPair = first->m_antennaPair;
+        second->m_channel = MatrixBasedChannelModel::Complex3DVector(1, 1, 1);
+        second->m_channel(0, 0, 0) = {2.0, 0.0};
+        NS_TEST_ASSERT_MSG_EQ(std::real((*loss->GetLongTerm(second, a, b))(0, 0, 0)),
+                              2.0, "Old long-term coefficients survived a same-time channel replacement");
+        loss->Dispose();
+        Simulator::Destroy();
+    }
+};
