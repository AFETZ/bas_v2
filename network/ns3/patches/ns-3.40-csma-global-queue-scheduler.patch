 void
+CsmaNetDevice::SetQueueReadyCallback(Callback<void> callback)
+{
+    NS_LOG_FUNCTION(this);
+    NS_ASSERT_MSG(m_txMachineState == READY && !m_currentPkt,
+                  "CsmaNetDevice::SetQueueReadyCallback(): scheduler must be installed while READY");
+    m_queueReadyCallback = callback;
+}
+
+bool
+CsmaNetDevice::IsTransmitReady() const
+{
+    return IsSendEnabled() && m_txMachineState == READY && !m_currentPkt;
+}
+
+bool
+CsmaNetDevice::StartOneQueuedPacket()
+{
+    NS_LOG_FUNCTION(this);
+    if (!IsTransmitReady() || !m_queue || m_queue->IsEmpty())
+    {
+        return false;
+    }
+
+    Ptr<Packet> packet = m_queue->Dequeue();
+    if (!packet)
+    {
+        // An external exact-packet grant may have expired or been invalidated.
+        // Never substitute the local queue head: the shared scheduler will
+        // issue a fresh grant.
+        return false;
+    }
+    m_currentPkt = packet;
+    m_promiscSnifferTrace(m_currentPkt);
+    m_snifferTrace(m_currentPkt);
+    TransmitStart();
+    return m_currentPkt != nullptr;
+}
+
+void
+CsmaNetDevice::RequestCurrentPacketAbortOnNextBusy()
+{
+    NS_LOG_FUNCTION(this);
+    if (m_currentPkt && m_txMachineState == BACKOFF)
+    {
+        m_abortCurrentPacketOnNextBusy = true;
+    }
+}
+
+void
+CsmaNetDevice::NotifyQueueReady()
+{
+    if (!m_queueReadyCallback.IsNull())
+    {
+        m_queueReadyCallback();
+    }
+}
