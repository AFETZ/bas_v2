+
+uint32_t
+TapBridgeFdReader::ReadAvailable(int fd, Callback<void, uint8_t*, ssize_t> callback,
+                                uint32_t maxFrames)
+{
+    m_fd = fd;
+    uint32_t frames = 0;
+    for (;;)
+    {
+        pollfd descriptor{fd, POLLIN, 0};
+        const auto ready = poll(&descriptor, 1, 0);
+        if (ready < 0 && errno == EINTR) continue;
+        if (ready < 0 || (descriptor.revents & (POLLERR | POLLHUP | POLLNVAL)))
+            throw std::runtime_error("lockstep TAP read failed");
+        if (ready == 0) return frames;
+        if (frames == maxFrames)
+            throw std::runtime_error("lockstep TAP ingress exceeded the boundary frame limit");
+        auto data = DoRead();
+        if (data.m_len <= 0)
+            throw std::runtime_error("lockstep TAP closed during boundary exchange");
+        callback(data.m_buf, data.m_len);
+        ++frames;
+    }
+}
+
+uint32_t
+TapBridge::ReadTap(uint32_t maxFrames)
+{
+    NS_ABORT_MSG_IF(!m_synchronousRead, "ReadTap requires SynchronousRead");
+    return m_fdReader ? m_fdReader->ReadAvailable(
+        m_sock, MakeCallback(&TapBridge::ReadCallback, this), maxFrames) : 0;
 }
 
