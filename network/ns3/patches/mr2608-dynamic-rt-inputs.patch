+namespace
+{
+void MakeDynamicDeviceInputsOpaque(const py::object& scene)
+{
+    // Sionna 1.2 makes the packed endpoints opaque only after Scene._endpoints
+    // scatters device fields. Literal moving fields otherwise specialize those
+    // packing kernels on every pose. Keep the exact values in device storage.
+    py::list fields;
+    for (const char* collection : {"transmitters", "receivers"})
+        for (auto device : scene.attr(collection).attr("values")())
+            for (const char* attribute : {"position", "orientation", "velocity"})
+                fields.append(device.attr(attribute));
+    const auto dr = py::module_::import("drjit");
+    dr.attr("make_opaque")(*py::tuple(fields));
+    const auto evaluated = dr.attr("VarState").attr("Evaluated");
+    for (auto field : fields)
+        if (!field.attr("state").attr("__eq__")(evaluated).cast<bool>())
+            throw std::runtime_error("Dynamic Sionna device input is not evaluated device storage");
+}
+} // namespace
+
 /// Conversion factor: degrees to radians
