+SionnaRtChannelModel::EmitterBatchStats
+SionnaRtChannelModel::GetEmitterBatchStats() const
+{
+    auto stats=m_emitterStats;
+    stats.bound=static_cast<bool>(m_emitterMobility); stats.hasPublishedBatch=m_emitterPublished;
+    stats.registeredReceivers=m_receiverBatchMobility.size();
+    stats.configuredSamplesPerSource=m_samplesPerSource; stats.configuredMaxPathsPerSource=m_maxNumPathsPerSource;
+    stats.configuredMaxNumberOfPaths=m_maxNumberOfPaths;
+    stats.candidateAllocationValid=stats.bound && stats.registeredReceivers &&
+        m_maxNumPathsPerSource<=std::numeric_limits<uint32_t>::max()/stats.registeredReceivers;
