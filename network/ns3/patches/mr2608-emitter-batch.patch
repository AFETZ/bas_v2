+std::pair<int64_t,int64_t>
+SionnaRtChannelModel::PublishReceiverBatchArrays(const py::object& coefficients,
+    const std::vector<py::object>& scalars,const py::object& valid,
+    Ptr<const MobilityModel> txMob,Ptr<const PhasedArrayModel> txAntenna,
+    const std::vector<size_t>& receivers)
+{
+    using Clock=std::chrono::steady_clock;
+    ValidateReceiverBatchEndpoints();
+    if (m_emitterMobility)
+    {
+        ValidateEmitterBatchBinding(); m_emitterPublished=false;
+        if (txMob!=m_emitterMobility || txAntenna!=m_emitterAntenna)
+            throw std::invalid_argument("Emitter publication transmitter mismatch");
+    }
+    std::vector<size_t> expected;
+    for(size_t i=0;i<m_receiverBatchMobility.size();++i)
+        if(m_receiverBatchMobility[i]!=txMob) expected.push_back(i);
+    if(receivers!=expected || (!m_emitterMobility && expected.size()+1!=m_receiverBatchMobility.size()))
+        throw std::invalid_argument("Receiver batch publication is not the exact registered receiver list");
+    const auto n=receivers.size();
+    std::vector<uint32_t> retained(n,0);
+    if (m_emitterMobility)
+    {
+        const auto shape=py::buffer(coefficients).request();
+        if(shape.ndim!=6 || shape.shape[0]!=static_cast<ssize_t>(n) || shape.shape[1]!=1 ||
+            shape.shape[2]!=1 || shape.shape[3]!=1 || shape.shape[5]!=1 ||
+            shape.format!=py::format_descriptor<std::complex<double>>::format() || scalars.size()!=6)
+            throw std::invalid_argument("Receiver batch requires complex128 CIR[N,1,1,1,P,1] and six scalar arrays");
+        const auto paths=shape.shape[4];
+        if(DoesNumberOfPathsExceedMaximum(paths))
+            throw std::runtime_error("Sionna batch retained-path limit exceeded; no automatic reduction");
+        const auto contiguous=[](const py::buffer_info& info) {
+            if(!info.size) return true;
+            auto stride=info.itemsize;
+            for(ssize_t i=info.ndim;i-- >0;) {if(info.strides[i]!=stride)return false;stride*=info.shape[i];}
+            return true;
+        };
+        const auto scalarShape=[&](const py::buffer_info& info) {
+            return info.ndim==3 && info.shape[0]==static_cast<ssize_t>(n) && info.shape[1]==1 && info.shape[2]==paths;
+        };
+        if(!contiguous(shape)) throw std::invalid_argument("Receiver CIR is not contiguous");
+        std::vector<py::buffer_info> scalarInfo;
+        for(const auto& scalar:scalars)
+        {
+            scalarInfo.push_back(py::buffer(scalar).request());
+            if(!scalarShape(scalarInfo.back()) || scalarInfo.back().format!=py::format_descriptor<double>::format() ||
+                !contiguous(scalarInfo.back())) throw std::invalid_argument("Receiver scalar shape/dtype/strides mismatch");
+        }
+        if(valid.is_none()) throw std::invalid_argument("Emitter publication requires an actual valid mask");
+        auto validInfo=py::buffer(valid).request();
+        if(!scalarShape(validInfo) || validInfo.format!=py::format_descriptor<bool>::format() || !contiguous(validInfo))
+            throw std::invalid_argument("Emitter valid mask shape/dtype/strides mismatch");
+        const auto* mask=static_cast<const bool*>(validInfo.ptr);
+        const auto* values=static_cast<const std::complex<double>*>(shape.ptr);
+        for(size_t receiver=0;receiver<n;++receiver) for(ssize_t path=0;path<paths;++path)
+        {
+            const auto offset=receiver*paths+path;
+            const auto coefficient=values[offset];
+            const auto delay=static_cast<const double*>(scalarInfo[0].ptr)[offset];
+            if(!std::isfinite(coefficient.real()) || !std::isfinite(coefficient.imag()) ||
+                (delay<0 && !(delay==-1 && coefficient==std::complex<double>{})))
+                throw std::invalid_argument("Receiver CIR has nonfinite coefficients or an active negative delay");
+            for(const auto& scalar:scalarInfo)
+                if(!std::isfinite(static_cast<const double*>(scalar.ptr)[offset]))
+                    throw std::invalid_argument("Receiver scalar contains nonfinite data");
+            if(!mask[offset] && coefficient!=std::complex<double>{})
+                throw std::invalid_argument("Invalid emitter path has a nonzero coefficient");
+            retained[receiver]+=mask[offset];
+        }
+    }
+    // Extract/validate all receiver tensors before publishing fresh matrices.
+    // Any exception propagates to the existing fail-closed simulator boundary.
+    std::vector<Ptr<ChannelMatrix>> matrices;
+    std::vector<Ptr<SionnaRtChannelParams>> parameters;
+    for (size_t index = 0; index < receivers.size(); ++index)
+    {
+        auto rxMob = m_receiverBatchMobility[receivers[index]];
+        auto rxAntenna = m_receiverBatchAntennas[receivers[index]];
+        auto matrix = CreateNewMatrixChannel(ConvertCirArray(coefficients, index), txMob,
+                                               rxMob, txAntenna, rxAntenna);
+        matrix->m_antennaPair = {txAntenna->GetId(), rxAntenna->GetId()};
+        matrices.push_back(matrix);
+        Double2DVector receiverAngles;
+        for (size_t angle = 2; angle < scalars.size(); ++angle)
+            receiverAngles.push_back(ConvertScalarPathArray(scalars[angle], index));
+        parameters.push_back(CreateChannelParams(txMob, rxMob,
+            ConvertScalarPathArray(scalars[0], index), ConvertScalarPathArray(scalars[1], index),
+            std::move(receiverAngles)));
+    }
+    const auto extractionFinished = Clock::now();
+    for (size_t index = 0; index < receivers.size(); ++index)
+    {
+        auto rxMob = m_receiverBatchMobility[receivers[index]];
+        auto rxAntenna = m_receiverBatchAntennas[receivers[index]];
+        const auto txId = txMob->GetObject<Node>()->GetId(), rxId = rxMob->GetObject<Node>()->GetId();
+        m_channelMatrixMap[GetKey(txAntenna->GetId(), rxAntenna->GetId())] = matrices[index];
+        m_channelParamsMap[GetKey(txId, rxId)] = parameters[index];
+        m_pairPositionSnapshots[GetKey(txId, rxId)] = {txId, txMob->GetPosition(), rxId,
+            rxMob->GetPosition(), txMob->GetVelocity(), rxMob->GetVelocity(),
+            BodyOrientation(txMob), BodyOrientation(rxMob)};
+        (void)txAntenna->IsChannelOutOfDate(rxAntenna); // This pair was just regenerated.
+    }
+
+    const auto published=Clock::now();
+    if(m_emitterMobility)
+    {
+        m_emitterStats.lastRetainedPathsPerReceiver=std::move(retained);
+        m_emitterStats.lastGeneratedNs=Simulator::Now().GetNanoSeconds();
+        m_emitterStats.lastSourcePosition=txMob->GetPosition();
+        m_emitterStats.lastSourceVelocity=txMob->GetVelocity();
+        m_emitterStats.lastSourceOrientation=EmitterOrientation(txMob,txAntenna);
+        m_emitterPublished=true;
+    }
+    return {std::chrono::duration_cast<std::chrono::nanoseconds>(extractionFinished.time_since_epoch()).count(),
+            std::chrono::duration_cast<std::chrono::nanoseconds>(published.time_since_epoch()).count()};
+}
+
+void
+SionnaRtChannelModel::SetEmitterBatchEndpoint(Ptr<const MobilityModel> mobility,
+                                            Ptr<const PhasedArrayModel> antenna)
+{
+    if (m_emitterMobility || !m_receiverBatchEnabled || !m_channelMatrixMap.empty() ||
+        !m_channelParamsMap.empty() || m_receiverBatchStats.attemptedCalls || m_fullMeshStats.attemptedCalls)
+        throw std::logic_error("Bind one emitter after enabling receivers and before any solve");
+    ValidateReceiverBatchEndpoints();
+    auto node=mobility ? mobility->GetObject<Node>() : nullptr;
+    if (!node || !antenna) throw std::invalid_argument("Emitter must have an attached node and array");
+    const auto pattern=EmitterArrayPattern(antenna);
+    ValidateEmitterPose(mobility,antenna);
+    std::vector<uint32_t> nodeIds,arrayIds;
+    std::vector<Vector> mounts{EmitterMount(antenna)};
+    for (size_t i=0;i<m_receiverBatchMobility.size();++i)
+    {
+        const auto rxNode=m_receiverBatchMobility[i]->GetObject<Node>();
+        if (rxNode==node || m_receiverBatchAntennas[i]==antenna)
+            throw std::invalid_argument("Emitter must be external to the registered receivers");
+        ValidateEmitterPose(m_receiverBatchMobility[i],m_receiverBatchAntennas[i]);
+        if (EmitterArrayPattern(m_receiverBatchAntennas[i])!="iso")
+            throw std::invalid_argument("Emitter receivers require iso0dBi with unit beam weights");
+        nodeIds.push_back(rxNode->GetId()); arrayIds.push_back(m_receiverBatchAntennas[i]->GetId());
+        mounts.push_back(EmitterMount(m_receiverBatchAntennas[i]));
+    }
+    m_emitterStats.frequencyHz=m_sceneConfigs.frequency; m_emitterStats.pattern=pattern;
+    m_emitterStats.sourceNodeId=node->GetId(); m_emitterStats.sourceAntennaId=antenna->GetId();
+    m_emitterStats.receiverNodeIds=std::move(nodeIds); m_emitterStats.receiverAntennaIds=std::move(arrayIds);
+    m_emitterMounts=std::move(mounts); m_emitterMobility=mobility; m_emitterAntenna=antenna;
+}
+
+void
+SionnaRtChannelModel::ValidateEmitterBatchBinding() const
+{
+    if (!m_emitterMobility || !m_emitterAntenna || !m_receiverBatchEnabled)
+        throw std::logic_error("Emitter batch endpoint is not bound/enabled");
+    ValidateReceiverBatchEndpoints();
+    const auto count=m_receiverBatchMobility.size();
+    ValidateEmitterPose(m_emitterMobility,m_emitterAntenna);
+    const auto node=m_emitterMobility->GetObject<Node>();
+    if (!node || node->GetId()!=m_emitterStats.sourceNodeId || m_emitterAntenna->GetId()!=m_emitterStats.sourceAntennaId ||
+        EmitterArrayPattern(m_emitterAntenna)!=m_emitterStats.pattern ||
+        m_sceneConfigs.frequency!=m_emitterStats.frequencyHz || m_emitterMounts.size()!=count+1 ||
+        EmitterMount(m_emitterAntenna)!=m_emitterMounts[0])
+        throw std::runtime_error("Emitter identity/carrier/pattern/mount changed after binding");
+    for (size_t i=0;i<count;++i)
+    {
+        ValidateEmitterPose(m_receiverBatchMobility[i],m_receiverBatchAntennas[i]);
+        if (EmitterArrayPattern(m_receiverBatchAntennas[i])!="iso")
+            throw std::runtime_error("Emitter receiver reference pattern/weights changed");
+        if (m_receiverBatchMobility[i]->GetObject<Node>()->GetId()!=m_emitterStats.receiverNodeIds[i] ||
+            m_receiverBatchAntennas[i]->GetId()!=m_emitterStats.receiverAntennaIds[i] ||
+            EmitterMount(m_receiverBatchAntennas[i])!=m_emitterMounts[i+1])
+            throw std::runtime_error("Emitter receiver identity/mount changed after binding");
+    }
+}
+
+size_t
+SionnaRtChannelModel::EmitterReceiverIndex(Ptr<const MobilityModel> a,Ptr<const MobilityModel> b) const
+{
+    ValidateEmitterBatchBinding();
+    if (a==b || (a!=m_emitterMobility && b!=m_emitterMobility))
+        throw std::invalid_argument("Emitter model permits STAR pairs only");
+    auto peer=a==m_emitterMobility ? b : a;
+    auto found=std::find(m_receiverBatchMobility.begin(),m_receiverBatchMobility.end(),peer);
+    if (found==m_receiverBatchMobility.end()) throw std::invalid_argument("Unknown emitter STAR receiver");
+    return std::distance(m_receiverBatchMobility.begin(),found);
+}
+
+Ptr<const MatrixBasedChannelModel::ChannelMatrix>
+SionnaRtChannelModel::ReadEmitterMatrix(Ptr<const MobilityModel> a,Ptr<const MobilityModel> b) const
+{
+    const auto peer=EmitterReceiverIndex(a,b);
+    const auto key=GetKey(m_emitterAntenna->GetId(),m_receiverBatchAntennas[peer]->GetId());
+    auto found=m_channelMatrixMap.find(key);
+    if (!m_emitterPublished || found==m_channelMatrixMap.end() || ChannelMatrixNeedsUpdate(found->second,a,b))
+        throw std::runtime_error("Emitter STAR channel missing/stale; explicit RefreshEmitterBatch required");
+    return found->second;
+}
