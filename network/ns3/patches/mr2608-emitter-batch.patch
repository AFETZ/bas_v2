+    stats.generatedLinks=batch.generatedLinks; stats.candidateCapacityReachedCalls=batch.candidateCapacityReachedCalls;
+    stats.lastTransmitterCount=batch.completedCalls ? 1 : 0; stats.lastReceiverCount=batch.lastReceiverCount;
+    stats.lastAllocatedCandidateCap=batch.lastAllocatedMaxPathsPerSource;
+    stats.lastCandidateCount=batch.lastCandidateCount; stats.lastCandidateBufferSize=batch.lastCandidateBufferSize;
+    stats.lastScenePrepareWallNs=batch.lastScenePrepareWallNs; stats.lastSolverWallNs=batch.lastSolverWallNs;
+    stats.lastExtractionWallNs=batch.lastExtractionWallNs; stats.lastCachePublishWallNs=batch.lastCachePublishWallNs;
+    stats.lastBatchWallNs=batch.lastBatchWallNs; stats.maxBatchWallNs=batch.maxBatchWallNs;
+    return stats;
+}
