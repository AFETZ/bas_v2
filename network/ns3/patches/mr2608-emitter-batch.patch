+void
+SionnaRtChannelModel::RefreshEmitterBatch()
+{
+    py::gil_scoped_acquire gil;
+    ValidateEmitterBatchBinding();
+    (void)GetReceiverBatchAllocation(m_receiverBatchMobility.size()); // Before RT/import, including overflow.
+    ++m_emitterStats.attemptedCalls; m_emitterPublished=false;
+    GenerateReceiverBatch(m_emitterMobility,m_emitterAntenna);
+    ++m_emitterStats.completedCalls;
+}
