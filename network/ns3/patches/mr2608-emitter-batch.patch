+std::string EmitterArrayPattern(Ptr<const PhasedArrayModel> antenna)
+{
+    auto array = DynamicCast<const UniformPlanarArray>(antenna);
+    if (!array || array->GetNumRows()!=1 || array->GetNumColumns()!=1 || array->GetNumElems()!=1 ||
+        array->GetNumPorts()!=1 || array->GetNumPols()!=1 || array->GetPolSlant()!=0)
+        throw std::invalid_argument("Emitter requires a V1x1 array");
+    const auto& weights=array->GetBeamformingVectorRef();
+    if (weights.GetSize()!=1 || weights[0]!=std::complex<double>(1,0))
+        throw std::invalid_argument("Emitter requires fixed unit beam weights");
+    if (DynamicCast<const IsotropicAntennaModel>(array->GetAntennaElement()))
+    {
+        DoubleValue gain; array->GetAntennaElement()->GetAttribute("Gain",gain);
+        if (gain.Get()!=0) throw std::invalid_argument("Emitter iso element must be0dBi");
+        return "iso";
+    }
+    auto element=DynamicCast<const ThreeGppAntennaModel>(array->GetAntennaElement());
+    if (!element || element->GetRadiationPattern()!=ThreeGppAntennaModel::RadiationPattern::OUTDOOR ||
+        element->GetVerticalBeamwidth()!=65 || element->GetHorizontalBeamwidth()!=65 ||
+        element->GetMaxAttenuation()!=30 || element->GetSlaV()!=30 || element->GetAntennaElementGain()!=8)
+        throw std::invalid_argument("Emitter supports only iso or fixed TR38901 OUTDOOR");
+    return "tr38901";
+}
+Vector EmitterMount(Ptr<const PhasedArrayModel> antenna)
+{
+    auto array=DynamicCast<const UniformPlanarArray>(antenna);
+    return {array->GetAlpha(),array->GetBeta(),0};
+}
+Vector EmitterOrientation(Ptr<const MobilityModel> mobility,Ptr<const PhasedArrayModel> antenna)
+{
+    VectorValue value;
+    return mobility->GetAttributeFailSafe("Orientation",value) ? value.Get() : EmitterMount(antenna);
+}
+void ValidateEmitterPose(Ptr<const MobilityModel> mobility,Ptr<const PhasedArrayModel> antenna)
+{
+    for (const auto& vector : {mobility->GetPosition(),mobility->GetVelocity(),
+                              EmitterOrientation(mobility,antenna),EmitterMount(antenna)})
+        if (!std::isfinite(vector.x) || !std::isfinite(vector.y) || !std::isfinite(vector.z))
+            throw std::invalid_argument("Emitter endpoint has nonfinite position/velocity/orientation/mount");
+}
