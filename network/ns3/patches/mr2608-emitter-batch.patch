+void
+SionnaRtChannelModel::ValidateEmitterBatchCandidates(uint32_t count,uint32_t capacity)
+{
+    ValidateEmitterBatchBinding();
+    const auto expected=GetReceiverBatchAllocation(m_receiverBatchMobility.size());
+    if (capacity!=expected || count>capacity)
+        throw std::invalid_argument("Emitter candidate allocation/count mismatch");
+    m_receiverBatchStats.lastCandidateCount=count; m_receiverBatchStats.lastCandidateBufferSize=capacity;
+    if (count>=capacity)
+    {
