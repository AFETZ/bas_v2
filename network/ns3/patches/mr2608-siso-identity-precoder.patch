+    // With one RX/TX port and no explicit precoder, P is exactly (1+0i).
+    // Preserve both complex products and the original zero-initialized sum,
+    // while avoiding the replicated precoder and intermediate matrix arrays.
+    if (!rxParams->precodingMatrix && numTxPorts == 1 && numRxPorts == 1)
+    {
+        for (uint32_t rbIdx = 0; rbIdx < rxParams->psd->GetValuesN(); ++rbIdx)
+        {
+            const auto hP = (*rxParams->spectrumChannelMatrix)(0, 0, rbIdx) *
+                            std::complex<double>(1.0, 0.0);
+            (*rxParams->psd)[rbIdx] = 0.0;
+            (*rxParams->psd)[rbIdx] += std::real(std::conj(hP) * hP);
+        }
+        return rxParams;
+    }
