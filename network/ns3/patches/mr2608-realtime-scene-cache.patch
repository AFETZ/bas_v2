+    const uint32_t aNodeId = aMob->GetObject<Node>()->GetId();
+    const uint32_t bNodeId = bMob->GetObject<Node>()->GetId();
+    const uint64_t pairKey = GetKey(aNodeId, bNodeId);
+    uint64_t mixedPair = pairKey + 0x9e3779b97f4a7c15ULL;
+    mixedPair = (mixedPair ^ (mixedPair >> 30U)) * 0xbf58476d1ce4e5b9ULL;
+    mixedPair = (mixedPair ^ (mixedPair >> 27U)) * 0x94d049bb133111ebULL;
+    mixedPair ^= mixedPair >> 31U;
+    const double pairUnit = static_cast<double>(mixedPair % 1000003ULL) / 1000002.0;
+    const double pairThresholdScale = 1.0 - m_updateJitterFraction * pairUnit;
 
     // if the coherence time is over the channel has to be updated
+    const Time pairUpdatePeriod = Seconds(m_updatePeriod.GetSeconds() * pairThresholdScale);
     if (!m_updatePeriod.IsZero() &&
-        Simulator::Now() - channelMatrix->m_generatedTime > m_updatePeriod)
+        Simulator::Now() - channelMatrix->m_generatedTime > pairUpdatePeriod)
     {
         NS_LOG_DEBUG("Generation time " << channelMatrix->m_generatedTime.As(Time::NS) << " now "
                                         << Now().As(Time::NS));
         update = true;
     }
 
+    if (m_updateDistanceThreshold > 0.0)
+    {
+        const auto snapshot = m_pairPositionSnapshots.find(pairKey);
+        if (snapshot != m_pairPositionSnapshots.end())
+        {
+            const PairPositionSnapshot& solved = snapshot->second;
+            const bool forward=solved.firstNodeId==aNodeId;
+            update |= CalculateDistance(aMob->GetVelocity(), forward ? solved.firstVelocity : solved.secondVelocity)>=0.5;
+            update |= CalculateDistance(bMob->GetVelocity(), forward ? solved.secondVelocity : solved.firstVelocity)>=0.5;
+            update |= BodyChanged(forward ? solved.firstOrientation : solved.secondOrientation, BodyOrientation(aMob));
+            update |= BodyChanged(forward ? solved.secondOrientation : solved.firstOrientation, BodyOrientation(bMob));
+            const Vector aAtSolve = solved.firstNodeId == aNodeId ? solved.firstPosition
+                                                                    : solved.secondPosition;
+            const Vector bAtSolve = solved.firstNodeId == bNodeId ? solved.firstPosition
+                                                                    : solved.secondPosition;
+            const double aDistance = CalculateDistance(aMob->GetPosition(), aAtSolve);
+            const double bDistance = CalculateDistance(bMob->GetPosition(), bAtSolve);
+            const double pairDistanceThreshold =
+                m_updateDistanceThreshold * pairThresholdScale;
+            if (aDistance >= pairDistanceThreshold || bDistance >= pairDistanceThreshold)
+            {
+                NS_LOG_INFO("Cached channel matrix marked for update (endpoint displacement: "
+                            << aDistance << ", " << bDistance << " m; threshold="
+                            << pairDistanceThreshold << " m; configured maximum="
+                            << m_updateDistanceThreshold << " m)");
+                update = true;
+            }
+        }
+    }
+
     return update;
+}
