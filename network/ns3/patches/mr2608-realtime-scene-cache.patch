+    mixedPair = (mixedPair ^ (mixedPair >> 27U)) * 0x94d049bb133111ebULL;
+    mixedPair ^= mixedPair >> 31U;
+    const double pairUnit = static_cast<double>(mixedPair % 1000003ULL) / 1000002.0;
+    const double pairThresholdScale = 1.0 - m_updateJitterFraction * pairUnit;
 
