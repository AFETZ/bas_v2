+Vector BodyOrientation(Ptr<const MobilityModel> mobility) {
+    VectorValue value;
+    return mobility->GetAttributeFailSafe("Orientation", value) ? value.Get() : Vector();
+}
+bool BodyChanged(const Vector& previous, const Vector& current) {
+    // Declared cache thresholds: 5 degrees rotation, 0.5 m/s velocity below.
+    const double limit=5*M_PI/180;
+    return std::abs(std::remainder(current.x-previous.x,2*M_PI))>=limit ||
+           std::abs(std::remainder(current.y-previous.y,2*M_PI))>=limit ||
+           std::abs(std::remainder(current.z-previous.z,2*M_PI))>=limit;
+}
+}
