+std::string
+SionnaRtChannelModel::AntennaSceneFingerprint(Ptr<const PhasedArrayModel> antenna) const
+{
+    auto upa = DynamicCast<const UniformPlanarArray>(antenna);
+    if (!upa)
+    {
+        return "non_uniform_" + std::to_string(antenna->GetId());
+    }
+    std::ostringstream value;
+    value << upa->GetNumRows() << 'x' << upa->GetNumColumns() << ':'
+          << upa->GetAntennaVerticalSpacing() << ':' << upa->GetAntennaHorizontalSpacing() << ':'
+          << static_cast<uint32_t>(upa->GetNumPols()) << ':' << upa->GetPolSlant() << ':'
+          << GetAntennaElementPattern(upa->GetAntennaElement());
+    return value.str();
 }
 
