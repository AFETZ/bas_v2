{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "network/config/evidence_manifest_schema.json",
  "title": "Immutable network/radio raw-evidence manifest",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "runtime_id",
    "source_hash",
    "sealed_utc",
    "matrix_sha256",
    "files"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "run_id": {"type": "string", "minLength": 1},
    "runtime_id": {"type": "string", "minLength": 8},
    "source_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sealed_utc": {"type": "string", "minLength": 20},
    "matrix_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "files": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["sha256", "size_bytes"],
        "properties": {
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
