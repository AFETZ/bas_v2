<?xml version="1.0"?>

<model>
  <name>Iris radio headless</name>
  <version>2.0</version>
  <sdf version="1.9">model.sdf</sdf>

  <author>
    <name>Gilbert Tanner</name>
    <email>gilbert.tanner@aau.at</email>
  </author>

  <maintainer email="gilbert.tanner@aau.at">Gilbert Tanner</maintainer>

  <description>
    Headless Iris model for radio-runtime tests. It keeps ArduPilot, IMU, battery, and odometry plugins and avoids rendering sensors.
  </description>
  <depend>
    <model>
      <uri>model://iris_with_ardupilot</uri>
      <version>1.0</version>
    </model>
  </depend>
</model>
