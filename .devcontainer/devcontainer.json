{
  "name": "BAS v2 (ROS 2 / Gazebo / ArduPilot)",
  "image": "multiagent_simulation:latest",
  "runArgs": [
    "--privileged",
    "--network=host",
    "--gpus=all",
    "-e", "NVIDIA_DRIVER_CAPABILITIES=compute,utility,graphics"
  ],
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace/multiagent_simulation,type=bind",
  "workspaceFolder": "/workspace/multiagent_simulation",
  "remoteUser": "ubuntu",
  "updateRemoteUserUID": false,
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/bin/python3"
      }
    }
  },
  "postCreateCommand": "bash /workspace/setup.sh"
}
